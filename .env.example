# Copy to .env and fill in your values. NEVER commit .env.
# Used by: the frontend build (VITE_*), scripts/*, and edge functions.

# Frontend (anon / publishable key — safe to expose in the SPA bundle)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_KEY=sb_publishable_YOUR_ANON_KEY

# NOTE: the admin e-mail is NOT a VITE_ variable any more (it would be shipped
# in the public JS bundle). Set it server-side:
#   INSERT INTO public.app_settings (key, value) VALUES ('admin_email', 'you@example.com');
#   and for the scraper edge function: supabase secrets set SCRAPE_ADMIN_EMAILS=you@example.com

# Server-side (scripts/*, CI jobs) — service role key, bypasses RLS. KEEP SECRET.
SUPABASE_SERVICE_KEY=sb_secret_YOUR_SERVICE_KEY

# Google AI (Gemma/Gemini) — used by scan, scrape, flavor-profile and price-range jobs
GEMINI_KEY=

# Optional — email jobs (Resend)
RESEND_API_KEY=
EMAIL_FROM=The Dram Journal <hello@dramjournal.online>

# Optional — dry-run emails (scripts/process-reengagement.js, generate-recommendations.js)
# SEND_EMAILS=false
